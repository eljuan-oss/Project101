* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html, body {
  width: 100%;
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  overflow: hidden;
  background-color: #0d1b22;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: url("images (4).jpg") center/cover no-repeat;
  z-index: 1;
}


.header {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  padding: 30px 40px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 10;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.4) 0%, rgba(0, 0, 0, 0) 100%);
}


.logo {
  background-color: #ffffff;
  color: #111111;
  font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-weight: 800;
  font-size: 15px;
  letter-spacing: 3px;
  padding: 8px 18px;
  text-transform: uppercase;
  display: inline-block;
}


.nav {
  display: flex;
  gap: 32px;
}

.nav-link {
  color: #ffffff;
  text-decoration: none;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  opacity: 0.85;
  padding-bottom: 4px;
  position: relative;
  transition: opacity 0.2s ease;
}

.nav-link:hover {
  opacity: 1;
}

.nav-link.active {
  opacity: 1;
}

.nav-link.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 2px;
  background-color: #ffffff;
}


.gallery-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 180px;
  display: flex;
  z-index: 10;
}

.gallery-item {
  flex: 1;
  height: 100%;
  overflow: hidden;
  position: relative;
  border-right: 1px solid rgba(255, 255, 255, 0.05);
}

.gallery-item:last-child {
  border-right: none;
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease, filter 0.3s ease;
}

.gallery-item:hover img {
  transform: scale(1.05);
  filter: brightness(1.1);
}


@media (max-width: 768px) {
  .header {
    flex-direction: column;
    gap: 15px;
    align-items: flex-start;
    padding: 20px;
  }

  .nav {
    gap: 15px;
    flex-wrap: wrap;
  }

  .gallery-bar {
    height: 120px;
  }
}
